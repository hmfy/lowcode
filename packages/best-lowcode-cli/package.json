{
  "name": "best-lowcode-devtools",
  "version": "0.2.2",
  "description": "CLI and MCP server for controlled BEST low-code development.",
  "keywords": [
    "best",
    "low-code",
    "cli",
    "mcp",
    "model-context-protocol"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "best": "./dist/bin.js",
    "best-lowcode-mcp": "./dist/mcp-server.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "best": "node dist/bin.js",
    "build": "pnpm --filter best-lowcode-runtime build && tsc -p tsconfig.build.json && node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev:best": "tsx src/bin.ts",
    "dev:mcp:server": "tsx src/mcp/bin.ts",
    "mcp:server": "node dist/mcp-server.js",
    "prepack": "pnpm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "semver": "^7.7.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "best-lowcode-runtime": "workspace:*",
    "@types/semver": "^7.7.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
