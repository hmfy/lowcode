{
  "name": "best-lowcode-installer",
  "version": "0.1.9",
  "description": "Install BEST low-code skills, DevTools, and MCP registrations for coding agents.",
  "keywords": [
    "best",
    "low-code",
    "installer",
    "mcp",
    "codex",
    "cursor"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "bin": {
    "best-lowcode-install": "./dist/bin.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.20.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
